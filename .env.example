# Copie para .env e troque a senha:  cp .env.example .env
# Dentro do Docker, a API acessa o banco pelo nome do serviço ("db") na porta interna 5432.
DB_USER=bank_user
DB_PASSWORD=change_me
DB_NAME=bank_db
DB_HOST=db
DB_PORT=5432

# Opcional (E01): origens que podem chamar a API direto de outro endereço (CORS),
# separadas por vírgula. O frontend usa o proxy /api e não depende disto.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
