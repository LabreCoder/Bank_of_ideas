# Normaliza finais de linha: LF no repositório e no checkout,
# independente do core.autocrlf de cada máquina.
* text=auto eol=lf

# Binários (nunca converter)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.mp3  binary
*.wav  binary
*.ogg  binary
*.woff binary
*.woff2 binary
